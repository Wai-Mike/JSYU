# Production settings for jsyu.org on cPanel.
# Copy to .env on the server and replace every CHANGE_ME_ value. See DEPLOYMENT.md.

APP_NAME="Jonglei State Youth Union"
APP_ENV=production
# Generated by scripts/cpanel-deploy.sh on first run (php artisan key:generate)
APP_KEY=
APP_DEBUG=false
APP_URL=https://jsyu.org
# Portal for officials and members; create this subdomain in cPanel (DEPLOYMENT.md, step 2)
ADMIN_DOMAIN=portal.jsyu.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# cPanel → MySQL Databases. cPanel prefixes names with your account, e.g. cpuser_jsyu
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME_cpuser_jsyu
DB_USERNAME=CHANGE_ME_cpuser_jsyu
DB_PASSWORD=CHANGE_ME_database_password

# One login across jsyu.org and portal.jsyu.org (note the leading dot)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.jsyu.org
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Nothing is queued yet, so no worker or cron job is needed
QUEUE_CONNECTION=sync
CACHE_STORE=database

# cPanel → Email Accounts: create noreply@jsyu.org, then use its "Connect Devices" SMTP settings
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.jsyu.org
MAIL_PORT=465
MAIL_USERNAME=noreply@jsyu.org
MAIL_PASSWORD=CHANGE_ME_email_password
MAIL_FROM_ADDRESS=noreply@jsyu.org
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Google Cloud Console → Credentials. Authorised redirect URI: https://jsyu.org/auth/google/callback
GOOGLE_CLIENT_ID=CHANGE_ME_google_client_id
GOOGLE_CLIENT_SECRET=CHANGE_ME_google_client_secret
GOOGLE_REDIRECT_URL=https://jsyu.org/auth/google/callback
